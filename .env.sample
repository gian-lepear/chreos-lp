# Digits-only international format (11-15 digits). Example: 5511976396660
# Required: the production build fails if this is missing or malformed.
VITE_CONTACT_FORM_WHATSAPP_NUMBER=

# Web3Forms access key — captures the contact-form lead server-side (e-mail).
# Public by design (ships in client JS). Get one free at https://web3forms.com
# Optional: the form has a baked-in fallback key, so leave blank to use it.
VITE_WEB3FORMS_KEY=

# Set to "true" in production to allow crawlers and generate sitemap.xml
# Leave unset or set to anything else to block all crawlers (staging/dev default)
ALLOW_INDEXING=

# Canonical site URL used in sitemap.xml and robots.txt (required when ALLOW_INDEXING=true)
# Example: https://chreos.com.br
SITE_URL=

# Google Analytics 4 measurement id (starts with G-). Optional: leave blank to
# run only Google Ads tracking. When set, the existing funnel events flow to GA4.
# Get it at analytics.google.com → Admin → Property → Web stream.
VITE_GA4_ID=
